{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "discography.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["artistSpotify", "discs"],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "artistSpotify": {
      "type": "string",
      "pattern": "^https://"
    },
    "discs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spotifyId", "title", "type", "year", "color", "cover", "tracks"],
        "properties": {
          "spotifyId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{22}$"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "type": {
            "$ref": "#/$defs/text"
          },
          "year": {
            "type": "integer",
            "minimum": 2018
          },
          "color": {
            "type": "string",
            "pattern": "^rgb\\(\\d{1,3},\\d{1,3},\\d{1,3}\\)$"
          },
          "cover": {
            "$ref": "#/$defs/asset"
          },
          "tracks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "durationSec"],
              "properties": {
                "title": {
                  "$ref": "#/$defs/text"
                },
                "durationSec": {
                  "type": "integer",
                  "minimum": 1
                },
                "guest": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "string",
      "pattern": "^assets-src/[a-z0-9/_.-]+\\.(webp|png|jpg|svg)$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "required": ["src", "alt"],
      "additionalProperties": false,
      "properties": {
        "src": {
          "$ref": "#/$defs/asset"
        },
        "alt": {
          "$ref": "#/$defs/text"
        },
        "caption": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
