{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "history.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "kicker", "intro", "events"],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "kicker": {
      "$ref": "#/$defs/text"
    },
    "intro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["photo", "paragraphs"],
      "properties": {
        "photo": {
          "$ref": "#/$defs/image"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "year", "tag", "title", "text", "photos"],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "year": {
            "type": "string",
            "pattern": "^[0-9]{4}(–[0-9]{4})?$"
          },
          "tag": {
            "$ref": "#/$defs/text"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "text": {
            "$ref": "#/$defs/text"
          },
          "photos": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/image"
            }
          },
          "badge": {
            "$ref": "#/$defs/image"
          },
          "discs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["spotifyId", "label"],
              "properties": {
                "spotifyId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]{22}$"
                },
                "label": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "string",
      "pattern": "^assets-src/[a-z0-9/_.-]+\\.(webp|png|jpg|svg)$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "required": ["src", "alt"],
      "additionalProperties": false,
      "properties": {
        "src": {
          "$ref": "#/$defs/asset"
        },
        "alt": {
          "$ref": "#/$defs/text"
        },
        "caption": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
