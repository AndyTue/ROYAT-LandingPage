{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "members.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "kicker", "groupPhoto", "director", "sections"],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "kicker": {
      "$ref": "#/$defs/text"
    },
    "groupPhoto": {
      "$ref": "#/$defs/image"
    },
    "director": {
      "$ref": "#/$defs/member"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "numeral", "groupPhoto", "members"],
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "numeral": {
            "type": "string",
            "pattern": "^[IVX]+\\.$"
          },
          "count": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "groupPhoto": {
            "$ref": "#/$defs/image"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/member"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "string",
      "pattern": "^assets-src/[a-z0-9/_.-]+\\.(webp|png|jpg|svg)$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "required": ["src", "alt"],
      "additionalProperties": false,
      "properties": {
        "src": {
          "$ref": "#/$defs/asset"
        },
        "alt": {
          "$ref": "#/$defs/text"
        },
        "caption": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "name", "role", "photo"],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "role": {
          "$ref": "#/$defs/text"
        },
        "photo": {
          "$ref": "#/$defs/asset"
        }
      }
    }
  }
}
