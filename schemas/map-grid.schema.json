{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "map-grid.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["W", "H", "S", "rows", "palette"],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "W": {
      "type": "integer",
      "minimum": 1
    },
    "H": {
      "type": "integer",
      "minimum": 1
    },
    "S": {
      "type": "integer",
      "minimum": 1
    },
    "lab": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        ]
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[.0-9a-z*,]+$"
      }
    },
    "palette": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "string",
      "pattern": "^assets-src/[a-z0-9/_.-]+\\.(webp|png|jpg|svg)$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "required": ["src", "alt"],
      "additionalProperties": false,
      "properties": {
        "src": {
          "$ref": "#/$defs/asset"
        },
        "alt": {
          "$ref": "#/$defs/text"
        },
        "caption": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
